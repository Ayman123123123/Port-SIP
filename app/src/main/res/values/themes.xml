<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.PortSIP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Full-screen incoming call theme (no status bar, keep screen on) -->
    <style name="Theme.PortSIP.IncomingCall" parent="Theme.PortSIP">
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/call_background</item>
        <item name="android:statusBarColor">@color/call_background</item>
    </style>

    <!-- Circular call-control icon buttons; selected state shows the brand color -->
    <style name="CallControlIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:background">@drawable/bg_control_selector</item>
        <item name="android:tint">@color/call_control_icon_tint</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:contentDescription">@string/call</item>
    </style>

    <!-- Small square keypad keys on the call screen -->
    <style name="CallKeypadKey" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Larger dialer keypad keys -->
    <style name="DialerKey" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
